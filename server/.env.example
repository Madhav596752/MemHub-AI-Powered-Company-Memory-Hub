# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Port the Express API listens on
PORT=5000

# URL of the React frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# JWT secrets (use long random strings, different for access and refresh)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
