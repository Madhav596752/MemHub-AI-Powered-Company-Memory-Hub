# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/memhub?schema=public"

PORT=5000
FRONTEND_URL=http://localhost:5173

# JWT (two DIFFERENT long random strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Refresh tokens are single-use. Re-using one that was already rotated more than this many seconds ago
# revokes the whole session (token theft). Inside the window it is only rejected (two tabs refreshing at once).
# REFRESH_REUSE_GRACE_SECONDS=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 3: embedding service (see server/embedding-service/README.md)
EMBEDDING_SERVICE_URL=http://localhost:8001
# Shared secret between Node and the Python service (REQUIRED). The embedding service now also reads this key
# from server/.env when it is not exported in the terminal (a terminal value wins), so ONE value in this file
# is enough. Without it the service refuses to start. Leave no spaces or quotes around the value.
EMBEDDING_SERVICE_TOKEN=
# Optional chunking settings (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Phase 3 Part 2: how long indexing one document may take (ms) and the default number of search results
INDEX_TIMEOUT_MS=300000
SEARCH_DEFAULT_LIMIT=5
# NOTE: CHROMA_PATH (where ChromaDB stores its files) is read by the PYTHON service, not by Node.
# Optional; the default is an absolute path: server/embedding-service/chroma_data (same folder no matter where uvicorn is started).

# Phase 3 Part 3: RAG question answering (server-side only; never put this key in the React app)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Optional: LLM_TIMEOUT_MS=30000
# Optional retrieval settings for /api/ask
# RAG_TOP_K=5                  chunks retrieved per question (1-20)
# RAG_MIN_SCORE=0.25           chunks scoring below this (1 - cosine distance) count as "not relevant"
# RAG_MAX_CONTEXT_CHARS=6000   most text that may be sent to the LLM as context

# ---------------------------------------------------------------------------------------------
# Knowledge graph + hybrid GraphRAG (all optional: without them the app works exactly as before)
# ---------------------------------------------------------------------------------------------
# Neo4j (Bolt). All three must be set, otherwise the graph feature is OFF. Never commit real values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j          # only if you do not use the default database

# Internal NLP service (server/nlp-service). Keep it bound to 127.0.0.1.
NLP_SERVICE_URL=http://localhost:8002
# Shared secret between Node and the NLP service (REQUIRED for graph processing). The NLP service reads this key
# from server/.env too when it is not exported in the terminal. Use a DIFFERENT value than the embedding token.
NLP_SERVICE_TOKEN=
# NLP_TIMEOUT_MS=30000          # per request to the NLP service
# NLP_BATCH_SIZE=25             # chunks per request (1-100)

# Hybrid retrieval limits for /api/ask
# GRAPH_MAX_FACTS=8             graph facts that may reach the prompt (1-30)
# GRAPH_MAX_CONTEXT_CHARS=1500  extra context allowance for graph evidence, ON TOP of RAG_MAX_CONTEXT_CHARS

# ---------------------------------------------------------------------------------------------
# Rate limiting + proxy (see README -> Authentication). All optional.
# ---------------------------------------------------------------------------------------------
# Shared counters for SEVERAL backend instances / production. Without it counters live in this process's memory
# (correct for ONE instance only). Never commit a real URL with a password.
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_REQUIRE_REDIS=true      # production: refuse to start without REDIS_URL
# Behind a reverse proxy / load balancer: number of proxy hops in front of this server (e.g. 1). Unset = no proxy.
# "true" is refused on purpose (clients could spoof their IP and dodge the limits).
# TRUST_PROXY=1
# Windows are in seconds. Defaults shown.
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600   RATE_LIMIT_REGISTER_MAX=10    # per IP
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900       RATE_LIMIT_LOGIN_MAX=20       # FAILED logins per IP
#                                           RATE_LIMIT_LOGIN_ACCOUNT_MAX=5 # FAILED logins per IP + email
# RATE_LIMIT_REFRESH_WINDOW_SECONDS=900     RATE_LIMIT_REFRESH_MAX=100    # per IP (refresh + logout)
# RATE_LIMIT_ASK_WINDOW_SECONDS=60          RATE_LIMIT_ASK_MAX=20         # per signed-in user
# NODE_ENV=production                        # enables HSTS and the production config checks (secrets >= 32 chars)
