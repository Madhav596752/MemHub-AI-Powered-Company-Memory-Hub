generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
  users     User[]
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(MEMBER)
  companyId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[] @relation("DocumentUploader")

  @@index([companyId])
}

model Document {
  id                String   @id @default(uuid())
  companyId         String
  uploadedBy        String?
  originalName      String
  fileName          String
  mimeType          String
  fileSize          Int
  cloudinaryUrl     String
  cloudinaryPublicId String
  extractedText     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader          User?    @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId])
  @@index([uploadedBy])
}

enum Role {
  ADMIN
  MEMBER
}
